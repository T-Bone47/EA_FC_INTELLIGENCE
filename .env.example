# EA FC Intelligence Environment Configuration Template
# Copy to .env and populate ONLY local credentials or override flags.
# Never commit real .env files or expose API keys in logs, frontend bundles, or responses.

ENVIRONMENT=development
DATABASE_URL=postgresql://eafc:eafc_dev_only@localhost:5432/eafc_intelligence
JWT_SECRET=

# Optional Redis URL for shared multi-worker rate limiting & cooldowns (defaults to in-process)
REDIS_URL=

# Optional CORS origins (comma-separated; empty = same-origin only)
CORS_ORIGINS=

# Game version defaults & research opt-in
DEFAULT_GAME_VERSION=FC26
FC27_CARD_RESEARCH_ENABLED=false
SUPPORTED_GAME_VERSIONS=FC26,FC27

# Phase 41.5 -> 42 Hybrid Agentic AI Football Coach (Gemini + OpenRouter Free Tiers Only)
AI_COACH_ENABLED=true
AI_COACH_PROVIDER=gemini
AI_COACH_FALLBACK_PROVIDER=openrouter

GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Mandatory strict free-only & privacy enforcement
AI_COACH_FREE_ONLY=true
AI_COACH_ALLOW_PAID_USAGE=false
AI_COACH_DETERMINISTIC_FALLBACK=true
AI_COACH_ALLOW_EXTERNAL_VIDEO=false
AI_COACH_VIDEO_UPLOAD_TO_LLM=false
AI_COACH_ALLOW_EXTERNAL_IMAGES=false

# Bounded agentic execution, fail-fast timeouts & circuit breakers (Phase 42C)
AI_COACH_MAX_TOOL_ROUNDS=3
AI_COACH_MAX_PROVIDER_REQUESTS_PER_TURN=4
AI_COACH_DAILY_PROVIDER_BUDGET=200
AI_COACH_REQUESTS_PER_MINUTE=15
AI_COACH_PER_USER_REQUESTS_PER_MINUTE=8
AI_COACH_TOKEN_BUDGET_PER_TURN=16000
AI_COACH_COOLDOWN_SECONDS=60
AI_COACH_CONCURRENT_REQUEST_LIMIT=3
AI_COACH_PROVIDER_TIMEOUT_SECONDS=16.0
AI_COACH_GEMINI_TIMEOUT_SECONDS=14.0
AI_COACH_OPENROUTER_TIMEOUT_SECONDS=16.0
AI_COACH_CIRCUIT_BREAKER_FAILURES=2
AI_COACH_CIRCUIT_BREAKER_COOLDOWN_SECONDS=120.0
AI_COACH_CATALOG_REFRESH_SECONDS=1800
