# EA FC Player Intelligence — environment template.
# Copy to .env (never commit the real file). Values marked REQUIRED must be set
# in production; the app refuses to start in ENVIRONMENT=production without
# JWT_SECRET.

# --- runtime ---
ENVIRONMENT=production                 # development | staging | production

# --- database (REQUIRED) ---
DATABASE_URL=postgresql://eafc:CHANGE_ME_STRONG_PASSWORD@127.0.0.1:5432/eafc_intelligence

# --- auth (JWT_SECRET REQUIRED in production) ---
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=720

# --- CORS ---
# Comma-separated allowlist of exact browser origins. Empty = same-origin only
# (correct when the API also serves frontend/dist behind one reverse proxy).
CORS_ORIGINS=

# --- rate limits (per IP per minute) and request size cap (bytes) ---
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_REQUESTS_PER_MINUTE=240
MAX_REQUEST_BYTES=1000000

# --- versioning ---
DEFAULT_GAME_VERSION=FC26
SUPPORTED_GAME_VERSIONS=FC26,FC27

# --- frontend ---
# Absolute path to the built SPA (frontend/dist). When set, the API serves the
# UI on the same origin; leave empty to run API-only behind a separate static host.
FRONTEND_DIST=/opt/eafc/frontend/dist
